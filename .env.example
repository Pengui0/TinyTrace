# Core LLM API Key (used for deterministic evidence synthesis & summaries)
GEMINI_API_KEY=""

# Upstream Investigation Providers (used for live investigations)
# DO NOT commit real keys to git or distribute in client bundles
TINYFISH_API_KEY=""
INDIACOS_API_KEY=""

# Optional Custom Endpoints (defaults to production URLs if omitted)
# TINYFISH_AGENT_URL="https://agent.tinyfish.ai"
# TINYFISH_SEARCH_URL="https://api.search.tinyfish.ai"
# INDIACOS_BASE_URL="https://indiacos.com/api/v1"

# Application Settings
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Supabase PostgreSQL workspace persistence (server only; never use a VITE_ prefix).
# Create the schema by running supabase/schema.sql in Supabase Dashboard > SQL Editor.
# Use the Project URL and a Secret API key (sb_secret_...) from Supabase API Keys.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_WORKSPACE_ID="default_ws"
# Browser-safe Supabase Auth settings. Use the Project URL and Publishable key;
# never put the Secret key in a VITE_ variable.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
# Legacy key name is supported if your project only shows the old service_role key.
# SUPABASE_SERVICE_ROLE_KEY=""

