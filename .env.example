# Core LLM API Key (used for deterministic evidence synthesis & summaries)
GEMINI_API_KEY=""

# Upstream Investigation Providers (Optional for local Demo Mode; required for Live Investigation)
# DO NOT commit real keys to git or distribute in client bundles
TINYFISH_API_KEY=""
INDIACOS_API_KEY=""

# Optional Custom Endpoints (defaults to production URLs if omitted)
# TINYFISH_AGENT_URL="https://agent.tinyfish.ai"
# TINYFISH_SEARCH_URL="https://api.search.tinyfish.ai"
# INDIACOS_BASE_URL="https://indiacos.com/api/v1"

# Application Settings
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Google sign-in (optional for local development)
# When enabled, every /api route except readiness/auth-config requires a verified ID token.
# The app currently has one shared workspace; this does not provide per-customer data isolation.
ENABLE_AUTH="false"
GOOGLE_CLIENT_ID=""
GOOGLE_ALLOWED_DOMAIN=""
GOOGLE_ALLOWED_EMAILS=""
# The current build uses DevInMemoryRepositoryAdapter only; durable Firestore storage is NOT wired.
# Setting FIREBASE_CONFIG or GOOGLE_APPLICATION_CREDENTIALS alone does not enable persistence.
# Implement and verify a persistent adapter before using real customer data.
# GOOGLE_APPLICATION_CREDENTIALS=""

